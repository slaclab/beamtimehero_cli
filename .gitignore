# local data
data/
# ...but `data/` matches at any depth, and test fixtures are not local data:
# tests/data/ holds captured excerpts of files that exist only on the beamline
# host (e.g. the SPEC config), which is the whole reason they are checked in.
!tests/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# runtime artifacts from the metadata-cache file lock
.scan_metadata_cache*.json.lock
.scan_metadata_cache*.json

# Agent worktrees created by the Claude Code harness.
.claude/worktrees/
